# Copy this file to ".env" in the same folder as app.py and fill in the values.
#
#     cp .env.example .env
#
# The app reads .env at startup, so the Credentials panel is prefilled and you do not
# have to paste keys on every run. Restart the app after editing this file --
# Streamlit reads it once, at import.
#
# A real environment variable always wins over this file, so a deployed environment can
# override it without editing anything here.
#
# .env is listed in .gitignore, but that does NOT protect a zip. Delete or exclude .env
# before zipping this folder to send to anyone.

# --- NVIDIA: generates the Executive Brief. -------------------------------------
# Without it the app still runs and falls back to the local deterministic brief,
# clearly labelled as a fallback.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# Set only if NVIDIA provides a different chat endpoint for your account/deployment.
# HTTP 410 Gone at the documented hosted URL requires service/account investigation.
# NVIDIA_CHAT_URL=https://integrate.api.nvidia.com/v1/chat/completions

# --- Apify: Google Trends search-demand signal (Signal Search tab). -------------
# Off by default. Needs an Apify account: set ENABLE_SIGNAL_SEARCH=true to show the tab and the
# Apify token field. Without it the Apify collector is skipped and no credits are used.
# ENABLE_SIGNAL_SEARCH=false
APIFY_API_TOKEN=

# --- BLS: raises the CPI request rate limit. Optional. --------------------------
# The BLS API works without a key at a lower daily limit.
BLS_API_KEY=

# --- Client-session switches. Optional. -----------------------------------------
# The Credentials panel (API key fields + connectivity test) always shows in the
# sidebar now -- it no longer depends on this setting or on a .env file being present.
# This switch only hides the separate developer-facing "Raw Data" tab before a client
# session; it has no effect on the Credentials panel.
# HIDE_ADMIN_CONTROLS=false

# Under Evidence Audit, show the system prompt, the user prompt and the raw payload.
# Off by default; that is internal review material, not client material.
# SHOW_LLM_TRACE=false

# --- Local run history / incident database. Optional. ---------------------------
# Defaults to market_intelligence_runs.db beside app.py. Point this somewhere else to
# keep demo runs out of the copy you hand over.
# MARKET_INTELLIGENCE_DB=

# --- What-if scenario tab (inside the Operational Impact Center). Optional. ---------
# Set to false to hide the what-if scenario tab in a client-facing session.
# ENABLE_SCENARIO_LAB=true

# Backup on repeated service/validation failures; same NVIDIA API endpoint/key.
# Set empty to disable the model switch. Authentication failures are not retried.
NVIDIA_BACKUP_MODEL=meta/llama-3.3-70b-instruct
